@startuml
rectangle Comet
rectangle CometConfiguration
rectangle CometCore
rectangle CometExt
rectangle CometFactory
rectangle CometBundleInterface
rectangle CometMath
rectangle CometStorage
rectangle ERC20

Comet --> CometCore
CometCore --> CometConfiguration
CometCore --> CometStorage
CometCore --> CometMath
CometExt --> CometCore
CometFactory --> CometConfiguration
CometBundleInterface --> CometCore
CometBundleInterface --> ERC20

Comet ~~> CometExt : delegatecall
@enduml